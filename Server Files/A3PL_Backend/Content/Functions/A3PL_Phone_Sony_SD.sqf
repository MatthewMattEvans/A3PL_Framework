["A3PL_Phone_SonySetStereo", {
	if(!life_radio_connected) exitWith {[("STR_A3PL_Phone_YouAreNotConnectedToTheRadio" call A3PL_Localize),Color_Red] call A3PL_Notification;};
	private _type = _this select 0;
	private _mode = _this select 1;
	private _freq = A3PL_Sony_Freq;
	private _freq2 = A3PL_Sony_FreqAdd;

	if(_type isEqualTo 1 && _freq isEqualTo 0) exitWith {[("STR_A3PL_Phone_ModeNotActivated" call A3PL_Localize),Color_Red] call A3PL_Notification;};
	if(_type isEqualTo 2 && _freq2 isEqualTo 0) exitWith {[("STR_A3PL_Phone_ModeNotActivated" call A3PL_Localize),Color_Red] call A3PL_Notification;};

	switch (_type) do {
		case 1 : {
			switch (_mode) do {
				case "G" : {
					[(call TFAR_fnc_ActiveSWRadio), 1] call TFAR_fnc_setSwStereo;
				};
				case "M" : {
					[(call TFAR_fnc_ActiveSWRadio), 0] call TFAR_fnc_setSwStereo;
				};
				case "D" : {
					[(call TFAR_fnc_ActiveSWRadio), 2] call TFAR_fnc_setSwStereo;
				};
			};
		};
		case 2 : {
			switch (_mode) do {
				case "G" : {
					[(call TFAR_fnc_ActiveSWRadio), 1] call TFAR_fnc_setAdditionalSwStereo;
				};
				case "M" : {
					[(call TFAR_fnc_ActiveSWRadio), 0] call TFAR_fnc_setAdditionalSwStereo;
				};
				case "D" : {
					[(call TFAR_fnc_ActiveSWRadio), 2] call TFAR_fnc_setAdditionalSwStereo;
				};
			};
		};
	};
}] call compile_Global;

["A3PL_Phone_SonySetVolume", {
	private["_mode","_volume"];
	_mode = _this select 0;

	switch (_mode) do {
		case "UP" : {
			_volume = (call TFAR_fnc_ActiveSwRadio) call TFAR_fnc_getSwVolume;
			_volume = _volume + 1;
			if(_volume > 10) then { _volume = 10;};
			[(call TFAR_fnc_ActiveSWRadio), _volume] call TFAR_fnc_setSwVolume;
		};
		case "DOWN" : {
			_volume = (call TFAR_fnc_ActiveSwRadio) call TFAR_fnc_getSwVolume;
			_volume = _volume - 1;
			if(_volume < 1) then { _volume = 1; };
			[(call TFAR_fnc_ActiveSWRadio), _volume] call TFAR_fnc_setSwVolume;
		};
	};
}] call compile_Global;

