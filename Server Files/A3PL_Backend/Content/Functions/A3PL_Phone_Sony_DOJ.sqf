            _playerList lbAdd format["%1 - %2",_name,_number];
            _playerList lbSetdata [(lbSize _playerList)-1, _infoToPass];
        } foreach _data;
        _delButton ctrlShow true;
        _delButton buttonSetAction "[] spawn A3PL_Phone_deleteSmsSonyDOJ;";
    };
    ((findDisplay 58999) displayCtrl 39144) lbSetCurSel 0;
}] call compile_Global;

