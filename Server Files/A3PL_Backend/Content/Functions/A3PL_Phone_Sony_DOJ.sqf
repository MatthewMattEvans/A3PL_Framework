    if !(isNull (findDisplay 58999)) then {
        uiNamespace setVariable ['SonyDOJ',0];
        [] call A3PL_Phone_menuSonyDOJ;
    };
}] call compile_Global;

["A3PL_Phone_SonyDOJUnmute", {
	private["_radio","_channel","_currentFrequency"];
	iPhone_Mute = false;

	_radio = call TFAR_fnc_activeSwRadio;
	_channel = _radio call TFAR_fnc_getSwChannel;
	_currentFrequency = [_radio, _channel + 1] call TFAR_fnc_getChannelFrequency;

	[_radio, _channel, _currentFrequency, false] call TFAR_fnc_doSRTransmit;
