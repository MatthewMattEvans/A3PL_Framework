["A3PL_Phone_createFishJob",
{
	private _display = findDisplay 56400;
	private _title = ctrlText (_display displayCtrl 682649);
	private _description = ctrlText (_display displayCtrl 682650);
	private _phone = ctrlText (_display displayCtrl 682651);
	private _email = ctrlText (_display displayCtrl 682652);
	private _time = parseNumber ctrlText (_display displayCtrl 682653);

	if (_title isEqualTo "") exitWith {[("STR_A3PL_Phone_ChooseTitle" call A3PL_Localize),Color_Red] call A3PL_Notification;};
	if (_description isEqualTo "") exitWith {[("STR_A3PL_Phone_EnterDescription" call A3PL_Localize),Color_Red] call A3PL_Notification;};
	if ((_phone isEqualTo "") && (_email isEqualTo "")) exitWith {[("STR_A3PL_Phone_YouNeedToGiveYourPhoneNumberOrEmail" call A3PL_Localize),Color_Red] call A3PL_Notification;};
	if (_time isEqualTo "") exitWith {[("STR_A3PL_Phone_EnterMinutes" call A3PL_Localize),Color_Red] call A3PL_Notification;};
	if (_time > 1440) exitWith {[("STR_A3PL_Phone_CantChooseThisTime" call A3PL_Localize),Color_Red] call A3PL_Notification;};
	if (_time <= 0) exitWith {[("STR_A3PL_Phone_ErrorInferior0Mn" call A3PL_Localize),Color_Red] call A3PL_Notification;};

	_allowed = toArray("0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ.,'-/[]éà@ç€!?;:êè)(=+&<>*$ ");
	_allowed2 = toArray("0123456789");
	private _chrByte = toArray (_title);
	private _chrByte2 = toArray (_description);
	private _chrByte3 = toArray (_phone);
	private _chrByte4 = toArray (_email);
	_badChar = false;
	_invalidChar = "";
	{if(!(_x in _allowed)) exitWith {_badChar = true; _invalidChar = _x};} forEach _chrByte;
	{if(!(_x in _allowed)) exitWith {_badChar = true; _invalidChar = _x};} forEach _chrByte2;
	{if(!(_x in _allowed)) exitWith {_badChar = true;};} forEach _chrByte4;
	{if(!(_x in _allowed2)) exitWith {_badChar = true; _invalidChar = _x};} forEach _chrByte3;
	if(_badChar) exitWith {[format[("STR_A3PL_Phone_CharNotAuthorizedSpecify" call A3PL_Localize),_invalidChar],Color_Red] call A3PL_Notification;};
	private _lengthTitle = count (toArray(_title));
	if(_lengthTitle > 50) exitWith {[("STR_A3PL_Phone_50CharMax" call A3PL_Localize),Color_Red] call A3PL_Notification;};
	private _lengthDesc = count (toArray(_description));
	if(_lengthDesc > 255) exitWith {[("STR_A3PL_Phone_255CharMax" call A3PL_Localize),Color_Red] call A3PL_Notification;};
	private _lengthNumber = count (toArray(_phone));
	if(_lengthNumber > 10) exitWith {[("STR_A3PL_Phone_10CharMax" call A3PL_Localize),Color_Red] call A3PL_Notification;};
	private _lengthEmail = count (toArray(_phone));
	if(_lengthEmail > 100) exitWith {[("STR_A3PL_Phone_100CharMax" call A3PL_Localize),Color_Red] call A3PL_Notification;};

	if (_phone isEqualTo "") then {_phone = ("STR_A3PL_Phone_NoCommunicate" call A3PL_Localize);};
	if (_email isEqualTo "") then {_email = ("STR_A3PL_Phone_NoCommunicate" call A3PL_Localize);};

	private _price = _time * 10;
	private _pBank = player getVariable["Player_Bank",0];
	if(_price > _pBank) exitWith {[("STR_A3PL_Phone_YouDontHaveThisAmountInYourBankAccount" call A3PL_Localize),Color_Red] call A3PL_Notification;};
	player setVariable ["Player_Bank",_pBank-_price,true];

	[_title,_description,_phone,_email,_time] remoteExec ["Server_Phone_FishJobs_Create",2];

	[("STR_A3PL_Phone_AnnouncePublished" call A3PL_Localize),Color_Green] call A3PL_Notification;

	{[("STR_A3PL_Phone_NewAnnounce" call A3PL_Localize),Color_Green] remoteExec ["A3PL_Notification",_x];} foreach (allPlayers - [player]);
	
	closeDialog 0;
	[getPlayerUID player,(player getVariable ["character_id",""]),"Phone_FishJobs_Create",[format ["Titre: %1 | Description: %2 | Phone: %3 | Email: %4 | Duree: %5",_title,_description,_phone,_email,_time]]] remoteExec ["Server_Log_New",2];
}] call compile_Global;

