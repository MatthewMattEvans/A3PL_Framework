["A3PL_Phone_iPhoneRadioConnect", {
	disableSerialization;
	private _display = findDisplay 56400;
	private _freq = ctrlText 582505;
	private _exit = false;
	if(_freq isEqualTo "") exitWith {};
	private _length = count(_freq);
	private _chrByte = toArray (_freq);
	private _allowed = toArray("0123456789");
	if (!(_length isEqualTo 6)) exitWith {[("STR_A3PL_Phone_6CharForFreq" call A3PL_Localize),Color_Red] call A3PL_Notification;};
	if (_exit) exitWith {[("STR_A3PL_Phone_ErrorFreq" call A3PL_Localize),Color_Red] call A3PL_Notification;};
	if (parseNumber(_freq) < 100000) exitWith {[("STR_A3PL_Phone_ErrorFreq" call A3PL_Localize),Color_Red] call A3PL_Notification;};
	private _badChar = false;
	{if(!(_x in _allowed)) exitWith {_badChar = true;};} forEach _chrByte;
	if(_badChar) exitWith {};

	if(A3PL_Forfait isEqualTo 0) exitWith {[("STR_A3PL_Phone_SubscriptionFinished" call A3PL_Localize),Color_Red] call A3PL_Notification;};

	life_radio_connected = true;

	A3PL_iPhone_Freq = parseNumber(_freq);

	player setVariable ["tf_unable_to_use_radio", false];
	private _freqOffset = call A3PL_Radio_GetFrequencyOffset;
	[(call TFAR_fnc_activeSwRadio), 1, parseNumber(_freq) + _freqOffset] call TFAR_fnc_SetChannelFrequency;
	player setVariable ["iPhoneRadioFreq", parseNumber(_freq)];

	uiNamespace setVariable ['iphonemenu',7]; [] call A3PL_Phone_menuiPhone;

	private _myRadio = call TFAR_fnc_activeSwRadio;
	for "_i" from 0 to 1 step 0 do {
		private _alive = player getVariable["A3PL_Medical_Alive",true];
		if !(_alive) exitWith {[_myRadio] call A3PL_Phone_iPhoneRadioDisconnect;};
		private _radios = player call TFAR_fnc_radiosList;
		if(count _radios < 1) exitWith {[_myRadio] call A3PL_Phone_iPhoneRadioDisconnect;};
		if !([(call TFAR_fnc_activeSwRadio),_myRadio] call TFAR_fnc_isSameRadio) exitWith {[_myRadio] call A3PL_Phone_iPhoneRadioDisconnect;};
		if(!life_radio_connected) exitWith {};
		sleep 1;
	};
}] call compile_Global;

